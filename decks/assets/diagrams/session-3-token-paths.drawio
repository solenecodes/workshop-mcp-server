<mxfile host="drawio" type="device"><diagram id="session-3-token-paths" name="Session 3 · two ways to reach the API"><mxGraphModel dx="1460" dy="700" grid="1" gridSize="10" guides="1" page="1" pageWidth="1460" pageHeight="700" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Session 3 · should the Tickets API see Alice or the service?&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Two access models for the same request. A token for the MCP API is not a token for another API." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c-obo" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#8A5100;fillColor=#FFF8EC;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="1040" height="200" as="geometry"/></mxCell><mxCell id="t-c-obo" value="&lt;b&gt;Design option&lt;/b&gt; · user-specific access (delegation / OBO) · not deployed in the workshop" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="52" y="146" width="700" height="26" as="geometry"/></mxCell><mxCell id="c-svc" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#107C10;fillColor=#F2F9F2;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1040" height="200" as="geometry"/></mxCell><mxCell id="t-c-svc" value="&lt;b&gt;Our deployment&lt;/b&gt; · service access" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="52" y="446" width="420" height="26" as="geometry"/></mxCell><mxCell id="aliceA" value="&lt;b&gt;Alice&lt;/b&gt;&lt;br&gt;asks for CT-1001" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#FDEBCB;strokeColor=#8A5100;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="200" width="190" height="80" as="geometry"/></mxCell><mxCell id="mcpA" value="&lt;b&gt;MCP server&lt;/b&gt;&lt;br&gt;validates Alice's token,&lt;br&gt;then asks for a new one" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#FDEBCB;strokeColor=#8A5100;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="220" height="80" as="geometry"/></mxCell><mxCell id="apiA" value="&lt;b&gt;Tickets API&lt;/b&gt;&lt;br&gt;enforces Alice's rights&lt;br&gt;on each record" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#FDEBCB;strokeColor=#8A5100;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="200" width="230" height="80" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;issues every token" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#ECE3F8;strokeColor=#8661C5;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="620" y="362" width="200" height="56" as="geometry"/></mxCell><mxCell id="callerB" value="&lt;b&gt;Caller&lt;/b&gt;&lt;br&gt;token for the MCP API" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DDF0DD;strokeColor=#107C10;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="190" height="80" as="geometry"/></mxCell><mxCell id="mcpB" value="&lt;b&gt;ca-mcp-auth&lt;/b&gt;&lt;br&gt;protected MCP server,&lt;br&gt;own managed identity" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DDF0DD;strokeColor=#107C10;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="220" height="80" as="geometry"/></mxCell><mxCell id="apiB" value="&lt;b&gt;ca-mcp-apis&lt;/b&gt;&lt;br&gt;Tickets API, internal&lt;br&gt;sees the service" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DDF0DD;strokeColor=#107C10;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="820" y="500" width="230" height="80" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#8661C5;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aliceA" target="mcpA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#8661C5;dashed=1;dashPattern=8 4;exitX=0.4090909090909091;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.32142857142857145;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcpA" target="entra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="450" y="380"/></Array></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcpA" target="apiA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b1" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#8661C5;dashed=1;dashPattern=8 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="callerB" target="mcpB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b2" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#8661C5;dashed=1;dashPattern=8 4;exitX=0.5909090909090909;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.7142857142857143;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcpB" target="entra"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="402"/></Array></mxGeometry></mxCell><mxCell id="b3" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mcpB" target="apiB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b1" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="299" y="229" width="22" height="22" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="439" y="304" width="22" height="22" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="689" y="229" width="22" height="22" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="299" y="529" width="22" height="22" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="479" y="454" width="22" height="22" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="689" y="529" width="22" height="22" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Alice's token: audience = the MCP API, scope Mcp.Read.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; On-behalf-of (OBO): the MCP server exchanges it with Entra ID for a new token for the Tickets API, still in Alice's context. OBO creates no extra rights.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; The Tickets API applies Alice's access to the record she asked for. A read scope alone is not enough.&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; The caller's token is valid for the MCP API only.&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; The MCP server asks Entra ID for its own token (managed identity): audience = Tickets API, role Mcp.Backend.Read.&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp; The Tickets API sees the service, not the caller. The caller's token is never forwarded.&lt;br&gt;&lt;br&gt;&lt;b&gt;Our demo&lt;/b&gt;: service access. No OBO, no per-ticket access lists: every authorized caller sees the same fictional tickets." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#FFFFFF;strokeColor=#C8C8C8;spacing=10;" vertex="1" parent="1"><mxGeometry x="1110" y="140" width="320" height="500" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
