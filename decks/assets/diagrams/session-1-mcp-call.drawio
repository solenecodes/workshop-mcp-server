<mxfile host="drawio" type="device"><diagram id="session-1-mcp-call" name="Session 1 · one MCP call"><mxGraphModel dx="1460" dy="760" grid="1" gridSize="10" guides="1" page="1" pageWidth="1460" pageHeight="760" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Session 1 · one MCP call, end to end&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Contoso Tickets workshop · read-only, synthetic data · ca-mcp-public and ca-mcp-apis from infra/main.bicep (&amp;lt;token&amp;gt; = uniqueString)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="22" as="geometry"/></mxCell><mxCell id="c-host" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#5B5FC7;fillColor=#F5F5FD;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="300" height="300" as="geometry"/></mxCell><mxCell id="t-c-host" value="&lt;b&gt;Host&lt;/b&gt; · VS Code with GitHub Copilot" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="52" y="156" width="280" height="26" as="geometry"/></mxCell><mxCell id="c-clients" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#616161;fillColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="300" height="240" as="geometry"/></mxCell><mxCell id="t-c-clients" value="&lt;b&gt;Clients without a model&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="52" y="496" width="280" height="26" as="geometry"/></mxCell><mxCell id="c-cae" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#107C10;fillColor=#F2F9F2;" vertex="1" parent="1"><mxGeometry x="440" y="150" width="620" height="580" as="geometry"/></mxCell><mxCell id="t-c-cae" value="&lt;b&gt;Container Apps environment&lt;/b&gt; · cae-mcp-&amp;lt;token&amp;gt;" style="shape=label;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=none;strokeColor=none;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;spacingLeft=28;" vertex="1" parent="1"><mxGeometry x="452" y="156" width="600" height="28" as="geometry"/></mxCell><mxCell id="model" value="&lt;b&gt;Model API&lt;/b&gt; (the LLM)&lt;br&gt;proposes a tool call" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#E8E8FA;strokeColor=#5B5FC7;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="260" height="60" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;MCP client&lt;/b&gt;&lt;br&gt;one per server connection,&lt;br&gt;inside the host" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#E8E8FA;strokeColor=#5B5FC7;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="260" height="70" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt; · Session 1 page lab&lt;br&gt;one request per step" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#EFEFEF;strokeColor=#616161;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="260" height="70" as="geometry"/></mxCell><mxCell id="terminal" value="&lt;b&gt;Terminal client&lt;/b&gt;&lt;br&gt;npm run workshop" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#EFEFEF;strokeColor=#616161;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="260" height="70" as="geometry"/></mxCell><mxCell id="server" value="&lt;b&gt;ca-mcp-public-&amp;lt;token&amp;gt;&lt;/b&gt;&lt;br&gt;MCP server · tools only:&lt;br&gt;list_tickets, get_ticket" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DDF0DD;strokeColor=#107C10;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="480" y="340" width="250" height="90" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;ca-mcp-apis-&amp;lt;token&amp;gt;&lt;/b&gt;&lt;br&gt;Contoso Tickets REST API&lt;br&gt;internal ingress only" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DDF0DD;strokeColor=#107C10;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="340" width="230" height="90" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;SQLite&lt;/b&gt; · three fictional tickets&lt;br&gt;CT-1001 · CT-1002 · CT-1003" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DDF0DD;strokeColor=#107C10;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="800" y="530" width="230" height="60" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="model" target="client"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3888888888888889;entryDx=0;entryDy=0;" edge="1" parent="1" source="client" target="server"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.35714285714285715;exitDx=0;exitDy=0;entryX=0.32;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="server"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="565"/></Array></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.35714285714285715;exitDx=0;exitDy=0;entryX=0.68;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="terminal" target="server"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="650" y="665"/></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="server" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b1" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="179" y="289" width="22" height="22" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="389" y="364" width="22" height="22" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="429" y="554" width="22" height="22" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="459" y="654" width="22" height="22" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="754" y="374" width="22" height="22" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="904" y="469" width="22" height="22" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; The host asks its model API which tool to use. This step is not MCP: the model only proposes.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; The MCP client sends JSON-RPC 2.0 over Streamable HTTP: tools/list, then tools/call.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; The page lab sends one anonymous request per step. CORS accepts the GitHub Pages origin only.&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; The terminal client speaks the same protocol without any model.&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; Each tool maps to one REST operation: GET /tickets, GET /tickets/{ticketId}. The server calls it with its own managed identity (Mcp.Backend.Read).&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp; The API reads fictional tickets from SQLite. No writes, no Internet calls.&lt;br&gt;&lt;br&gt;&lt;b&gt;Remember&lt;/b&gt;: the model is not the server, and the server is an adapter, not a database." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#FFFFFF;strokeColor=#C8C8C8;spacing=10;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="320" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
