<mxfile host="drawio" type="device"><diagram id="deployed-architecture" name="Deployed architecture"><mxGraphModel dx="1460" dy="830" grid="1" gridSize="10" guides="1" page="1" pageWidth="1460" pageHeight="830" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Contoso Tickets MCP workshop · deployed architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="Sessions 1 and 2 · infra/main.bicep and infra/gateway/main.bicep · &amp;lt;token&amp;gt; = uniqueString(subscription, environment, region), generated by Bicep" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1000" height="22" as="geometry"/></mxCell><mxCell id="c-clients" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#5B5FC7;fillColor=#F5F5FD;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="240" height="440" as="geometry"/></mxCell><mxCell id="c-apim" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#0063B1;fillColor=#F0F6FC;" vertex="1" parent="1"><mxGeometry x="360" y="160" width="320" height="440" as="geometry"/></mxCell><mxCell id="c-cae" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#107C10;fillColor=#F2F9F2;" vertex="1" parent="1"><mxGeometry x="760" y="160" width="400" height="440" as="geometry"/></mxCell><mxCell id="c-entra" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 4;strokeWidth=2;strokeColor=#8661C5;fillColor=#F7F3FC;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1120" height="110" as="geometry"/></mxCell><mxCell id="t-clients" value="&lt;b&gt;Workshop clients&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="52" y="166" width="150" height="26" as="geometry"/></mxCell><mxCell id="t-apim" value="&lt;b&gt;API Management&lt;/b&gt; · apim-mcp-&amp;lt;token&amp;gt; · Basic v2" style="shape=label;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=none;strokeColor=none;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;spacingLeft=28;" vertex="1" parent="1"><mxGeometry x="372" y="166" width="300" height="26" as="geometry"/></mxCell><mxCell id="t-cae" value="&lt;b&gt;Container Apps environment&lt;/b&gt;&lt;br&gt;cae-mcp-&amp;lt;token&amp;gt;" style="shape=label;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=none;strokeColor=none;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;spacingLeft=28;" vertex="1" parent="1"><mxGeometry x="940" y="165" width="215" height="34" as="geometry"/></mxCell><mxCell id="t-entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt; · workshop tenant" style="shape=label;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=none;strokeColor=none;image=data:image/svg+xml,;imageWidth=22;imageHeight=22;imageAlign=left;imageVerticalAlign=middle;spacingLeft=28;" vertex="1" parent="1"><mxGeometry x="570" y="694" width="380" height="26" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;Session 1 page lab&lt;br&gt;anonymous" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#E8E8FA;strokeColor=#5B5FC7;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="200" height="70" as="geometry"/></mxCell><mxCell id="terminal" value="&lt;b&gt;Terminal client&lt;/b&gt;&lt;br&gt;npm run workshop&lt;br&gt;with an Mcp.Read token" style="shape=label;html=1;whiteSpace=wrap;rounded=0;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#E8E8FA;strokeColor=#5B5FC7;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="200" height="70" as="geometry"/></mxCell><mxCell id="bmcp" value="&lt;b&gt;MCP server · contoso-tickets-mcp&lt;/b&gt;&lt;br&gt;Pattern B: list_tickets, get_ticket" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DCEBFA;strokeColor=#0063B1;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="390" y="200" width="260" height="60" as="geometry"/></mxCell><mxCell id="rest" value="&lt;b&gt;REST API · contoso-tickets&lt;/b&gt;&lt;br&gt;answered by the policy from synthetic tickets, no backend" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DCEBFA;strokeColor=#0063B1;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="390" y="300" width="260" height="60" as="geometry"/></mxCell><mxCell id="amcp" value="&lt;b&gt;MCP server · contoso-tickets-existing&lt;/b&gt;&lt;br&gt;Pattern A: passthrough, same token" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#DCEBFA;strokeColor=#0063B1;spacingLeft=8;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="390" y="400" width="260" height="60" as="geometry"/></mxCell><mxCell id="prm" value="&lt;b&gt;Protected resource metadata&lt;/b&gt;