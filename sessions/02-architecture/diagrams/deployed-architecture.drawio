33333333;exitDx=0;exitDy=0;entryX=0;entryY=0.3125;entryDx=0;entryDy=0;" edge="1" parent="1" source="pub" target="apis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="972" y="220"/><mxPoint x="972" y="315"/></Array></mxGeometry></mxCell><mxCell id="e9" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6875;entryDx=0;entryDy=0;" edge="1" parent="1" source="auth" target="apis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="988" y="430"/><mxPoint x="988" y="345"/></Array></mxGeometry></mxCell><mxCell id="e10" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#8661C5;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8509615384615384;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mi" target="appreg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#333333;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mi" target="acr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="540"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=none;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;endSize=8;strokeColor=#8661C5;dashed=1;dashPattern=8 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4230769230769231;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c-apim" target="appreg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b1" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="509" y="104" width="22" height="22" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="334" y="219" width="22" height="22" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="329" y="419" width="22" height="22" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="344" y="529" width="22" height="22" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="149" y="634" width="22" height="22" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="509" y="634" width="22" height="22" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="954" y="634" width="22" height="22" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;8&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;aspect=fixed;fontSize=11;fontColor=#FFFFFF;fontFamily=Segoe UI;fillColor=#1F1F1F;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1169" y="529" width="22" height="22" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;How to read it&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Anonymous MCP call from the Session 1 page. CORS allows the GitHub Pages origin only.&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; Pattern B: each tool maps to one REST operation; the gateway answers from synthetic tickets.&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; Pattern A: forwarded as is; the protected server checks the same token again.&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; A 401 names this metadata: where to sign in, which scope.&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; Delegated token for this API only: scope Mcp.Read (az account get-access-token).&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp; The gateway checks signature, issuer, audience and Mcp.Read; 30 calls per minute per caller.&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&amp;nbsp; Each MCP app gets its own token (managed identity) for the ticket API. The caller token is never forwarded.&lt;br&gt;&lt;b&gt;8&lt;/b&gt;&amp;nbsp; Images are pulled with AcrPull, no registry password.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lines&lt;/b&gt;: solid = request · dashed purple = token · dotted blue = metadata lookup&lt;br&gt;&lt;br&gt;&lt;b&gt;Known gap&lt;/b&gt;: a direct call to ca-mcp-auth with a valid token still works (not restricted to the gateway yet)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontFamily=Segoe UI;fontColor=#1F1F1F;fillColor=#FFFFFF;strokeColor=#C8C8C8;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="240" height="430" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
